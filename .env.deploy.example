# ============================================================
# Modular RAG - API 部署环境变量清单（Docker / VPS 推荐）
# ============================================================
# 复制此文件为 .env，填入真实值后用于 docker-compose.api.yml
# 当前仓库推荐默认使用本地 Chroma 持久化目录；Qdrant 为可选外部向量库
# ============================================================

# ── LLM 配置（必填）────────────────────────────────────────
LLM_API_KEY=your_aihubmix_api_key_here
LLM_PROVIDER=openai
LLM_BASE_URL=https://aihubmix.com/v1
LLM_MODEL=coding-glm-5-free
# 可选模型: gemini-2.0-flash, gpt-4o

# ── Embedding 配置（必填）────────────────────────────────
EMBEDDING_API_KEY=your_aihubmix_api_key_here
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://aihubmix.com/v1
EMBEDDING_MODEL=qwen3-embedding-4b
EMBEDDING_DIMENSIONS=2560

# ── Vision LLM（可选 – PDF/图片理解）──────────────────────
VISION_LLM_API_KEY=your_aihubmix_api_key_here
VISION_LLM_PROVIDER=openai
VISION_LLM_BASE_URL=https://aihubmix.com/v1
VISION_LLM_MODEL=gpt-4o

# ── 向量数据库（默认：本地 Chroma）─────────────────────────
# 生产默认建议：
# 1. 直接复用仓库内已有的 ./data/db/chroma
# 2. 避免重新补 embedding
# 3. 配合 data/images 与 data/db/image_index.db 一起部署

VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PERSIST_DIRECTORY=./data/db/chroma
VECTOR_STORE_COLLECTION_NAME=default

# ── Qdrant（可选，只有 provider=qdrant 时才需要）──────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=default
QDRANT_VECTOR_DIM=2560

# ── Observability ─────────────────────────────────────────
# 设为 false 避免写入本地 trace 文件（Render 免费版 HDD 会丢）
OBSERVABILITY_TRACE_ENABLED=false

# ── Rerank（建议开启，提升检索排序质量）──────────────────
RERANK_ENABLED=true
RERANK_PROVIDER=llm
RERANK_MODEL=MiniMax-M2.7-highspeed
RERANK_TOP_K=10
RERANK_API_KEY=your_minimax_api_key_here
RERANK_BASE_URL=https://api.minimax.io/v1

# ── Lesson 生成优化 ───────────────────────────────────────
# 当前线上默认是增强版稳定配置
LESSON_REVIEW_ENABLED=true
LESSON_REVIEW_MODE=light
LESSON_PLANNER_USE_LLM=true
LESSON_FAST_MODE=false
LESSON_WRITER_MAX_CONTEXT_RESULTS=10
LESSON_WEB_IMAGE_MAX_IMAGES=3
UVICORN_WORKERS=3
LESSON_PLAN_REQUEST_TIMEOUT_SEC=120
LESSON_PLAN_STREAM_TIMEOUT_SEC=300
OPENAI_LLM_TIMEOUT_SEC=90
